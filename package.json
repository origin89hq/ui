{
  "name": "origin89-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "brand:generate": "node scripts/generate-brand.mjs",
    "brand:check": "node scripts/generate-brand.mjs --check",
    "build": "pnpm --filter @origin89/ui-react build",
    "test": "pnpm --filter @origin89/ui-react test",
    "check": "pnpm brand:check && biome ci . --error-on-warnings && pnpm build && pnpm test",
    "package": "pnpm --filter @origin89/ui-react pack --pack-destination dist",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --lockfile-only --ignore-scripts && pnpm check",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@origin89/brand": "0.4.0",
    "@biomejs/biome": "2.5.13",
    "typescript": "6.0.3",
    "@changesets/cli": "3.0.2"
  },
  "license": "UNLICENSED"
}
